---
import { resumeData } from '../data/resume';
---

<section class="w-full" id="research">
  {resumeData.publications.map((pub) => (
    <div class="relative overflow-hidden rounded-xl border border-indigo-200 dark:border-[#c0c1ff]/40 bg-white/90 dark:bg-[#181b25]/90 p-4 sm:p-6 md:p-8 shadow-md hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_35px_-5px_rgba(192,193,255,0.22)] transition-all hover:-translate-y-1.5 duration-300 group backdrop-blur-sm">
      <!-- Top Border Illuminating Glow Accent -->
      <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-indigo-500 dark:via-[#c0c1ff] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

      <!-- Ambient Decorative Glow -->
      <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-indigo-500/10 dark:bg-[#c0c1ff]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-5 sm:gap-6">
        <div class="flex flex-col gap-2 max-w-4xl">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1 rounded bg-indigo-50 dark:bg-[#c0c1ff]/15 border border-indigo-200 dark:border-[#c0c1ff]/30 text-indigo-700 dark:text-[#c0c1ff] font-mono text-[10px] sm:text-[11px] uppercase tracking-wider font-semibold">
              <span class="material-symbols-outlined text-[14px] sm:text-[15px]">school</span>
              <span>Peer-Reviewed Conference Paper</span>
            </span>
            <span class="inline-flex items-center gap-1 px-2 sm:px-2.5 py-0.5 rounded bg-slate-100 dark:bg-[#1c1f29] border border-slate-200 dark:border-[#1F2937] font-mono text-[10px] sm:text-[11px] font-semibold text-emerald-600 dark:text-[#4edea3]">
              <span class="material-symbols-outlined text-[13px] sm:text-[14px]">verified</span>
              <span>Academic Paper</span>
            </span>
          </div>

          <h3 class="text-lg sm:text-xl md:text-2xl text-slate-900 dark:text-[#dfe2ef] font-bold tracking-tight mt-1 leading-snug">
            {pub.title}
          </h3>

          <p class="text-sm sm:text-base text-slate-600 dark:text-[#c7c4d7]">
            {pub.venue}
          </p>
        </div>

        {pub.linkUrl && (
          <div class="w-full md:w-auto flex flex-col sm:flex-row items-center gap-3 shrink-0 pt-2 md:pt-0">
            <a
              href={pub.linkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-4 py-2.5 rounded bg-slate-100 dark:bg-[#1c1f29] border border-slate-200 dark:border-[#1F2937] text-slate-800 dark:text-[#dfe2ef] hover:border-indigo-500 dark:hover:border-[#c0c1ff] font-mono text-xs sm:text-[13px] font-medium flex items-center justify-center gap-2 transition-colors shadow-sm text-center"
            >
              <span class="material-symbols-outlined text-[16px]">menu_book</span>
              <span>{pub.linkLabel || 'Abstract & Code'}</span>
            </a>
          </div>
        )}
      </div>
    </div>
  ))}
</section>
