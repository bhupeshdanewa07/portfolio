---
import { resumeData } from '../data/resume';

const { languages, developerTools, technologiesAndFrameworks } = resumeData.skills;
---

<section class="flex flex-col gap-6" id="skills">
  <!-- Section Header -->
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-[#1F2937]/80 pb-3 transition-colors">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-indigo-600 dark:text-[#c0c1ff] text-[20px] sm:text-[22px]">terminal</span>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-900 dark:text-[#dfe2ef] tracking-tight">
        Technical Skills
      </h2>
    </div>
    <span class="font-mono text-xs sm:text-[13px] text-slate-500 dark:text-[#908fa0]">stack_telemetry</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <!-- Category 1: Languages -->
    <div class="relative overflow-hidden bg-white/90 dark:bg-[#181b25]/90 border border-slate-200 dark:border-[#1F2937] rounded-xl p-4 sm:p-6 flex flex-col gap-3 sm:gap-4 shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_25px_-5px_rgba(128,131,255,0.2)] transition-all hover:-translate-y-1 hover:border-indigo-400 dark:hover:border-[#8083ff] duration-300 group backdrop-blur-sm">
      <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-indigo-500 dark:via-[#8083ff] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      <div class="flex items-center gap-2 text-indigo-600 dark:text-[#c0c1ff] border-b border-slate-200 dark:border-[#1F2937]/60 pb-2">
        <span class="material-symbols-outlined text-[18px]">code</span>
        <h3 class="text-base sm:text-[17px] text-slate-900 dark:text-[#dfe2ef] font-semibold">Languages</h3>
      </div>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {languages.map((skill) => (
          <span class="px-2 sm:px-2.5 py-1 bg-slate-100 dark:bg-[#1c1f29] border border-slate-200 dark:border-[#1F2937] rounded font-mono text-xs sm:text-[13px] text-slate-800 dark:text-[#dfe2ef] hover:border-slate-400 dark:hover:border-[#464554] transition-colors">
            {skill}
          </span>
        ))}
      </div>
    </div>

    <!-- Category 2: Developer Tools -->
    <div class="relative overflow-hidden bg-white/90 dark:bg-[#181b25]/90 border border-slate-200 dark:border-[#1F2937] rounded-xl p-4 sm:p-6 flex flex-col gap-3 sm:gap-4 shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_25px_-5px_rgba(128,131,255,0.2)] transition-all hover:-translate-y-1 hover:border-indigo-400 dark:hover:border-[#8083ff] duration-300 group backdrop-blur-sm">
      <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-indigo-500 dark:via-[#8083ff] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      <div class="flex items-center gap-2 text-indigo-600 dark:text-[#c0c1ff] border-b border-slate-200 dark:border-[#1F2937]/60 pb-2">
        <span class="material-symbols-outlined text-[18px]">build</span>
        <h3 class="text-base sm:text-[17px] text-slate-900 dark:text-[#dfe2ef] font-semibold">Developer Tools</h3>
      </div>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {developerTools.map((skill) => (
          <span class="px-2 sm:px-2.5 py-1 bg-slate-100 dark:bg-[#1c1f29] border border-slate-200 dark:border-[#1F2937] rounded font-mono text-xs sm:text-[13px] text-slate-800 dark:text-[#dfe2ef] hover:border-slate-400 dark:hover:border-[#464554] transition-colors">
            {skill}
          </span>
        ))}
      </div>
    </div>

    <!-- Category 3: Technologies/Frameworks -->
    <div class="relative overflow-hidden bg-white/90 dark:bg-[#181b25]/90 border border-slate-200 dark:border-[#1F2937] rounded-xl p-4 sm:p-6 flex flex-col gap-3 sm:gap-4 shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_25px_-5px_rgba(128,131,255,0.2)] transition-all hover:-translate-y-1 hover:border-indigo-400 dark:hover:border-[#8083ff] duration-300 group backdrop-blur-sm">
      <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-indigo-500 dark:via-[#8083ff] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      <div class="flex items-center gap-2 text-indigo-600 dark:text-[#c0c1ff] border-b border-slate-200 dark:border-[#1F2937]/60 pb-2">
        <span class="material-symbols-outlined text-[18px]">memory</span>
        <h3 class="text-base sm:text-[17px] text-slate-900 dark:text-[#dfe2ef] font-semibold">Technologies & Frameworks</h3>
      </div>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {technologiesAndFrameworks.map((skill) => {
          const isHighlight = skill.includes("Learning") || skill.includes("cu") || skill.includes("RAPIDS") || skill.includes("LangChain");
          return (
            <span
              class={`px-2 sm:px-2.5 py-1 rounded font-mono text-xs sm:text-[13px] transition-colors ${
                isHighlight
                  ? "bg-indigo-50/70 dark:bg-[#1c1f29] border border-indigo-200 dark:border-[#8083ff]/40 text-indigo-700 dark:text-[#c0c1ff]"
                  : "bg-slate-100 dark:bg-[#1c1f29] border border-slate-200 dark:border-[#1F2937] text-slate-800 dark:text-[#dfe2ef] hover:border-slate-400 dark:hover:border-[#464554]"
              }`}
            >
              {skill}
            </span>
          );
        })}
      </div>
    </div>
  </div>
</section>
