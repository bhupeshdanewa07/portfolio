---
import { resumeData } from '../data/resume';

const navItems = [
  { label: 'Experience', href: '#experience' },
  { label: 'Projects', href: '#projects' },
  { label: 'Research', href: '#research' },
  { label: 'Skills', href: '#skills' },
  { label: 'Education', href: '#education' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="fixed top-0 left-0 right-0 w-full z-50 bg-white/95 dark:bg-[#0f131c]/95 backdrop-blur-md border-b border-slate-200 dark:border-[#1F2937] transition-colors duration-200 shadow-xs">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 md:px-10 h-14 flex items-center justify-between w-full">
    <!-- Brand / Monogram -->
    <div class="flex items-center gap-3">
      <a
        href={import.meta.env.BASE_URL}
        class="font-mono text-xs sm:text-[13px] font-bold tracking-wider text-slate-900 dark:text-[#dfe2ef] hover:text-indigo-600 dark:hover:text-[#c0c1ff] transition-colors flex items-center gap-2 group"
      >
        <img
          src={`${base}/logo.png`}
          alt="Bhupesh Danewa Logo"
          class="w-7 h-7 sm:w-8 sm:h-8 rounded object-cover shadow-sm group-hover:scale-105 transition-transform shrink-0"
        />
        <span class="tracking-wide text-slate-900 dark:text-[#dfe2ef] font-semibold whitespace-nowrap">// AI Engineer</span>
      </a>
    </div>

    <!-- Desktop Navigation (hidden on mobile, shown md+) with Scroll-Spy -->
    <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-section={item.href.replace('#', '')}
          class="nav-desktop-link px-3 py-1.5 rounded-lg font-mono text-[13px] text-slate-600 dark:text-[#908fa0] hover:text-slate-900 dark:hover:text-[#dfe2ef] hover:bg-slate-100 dark:hover:bg-[#181b25] transition-all flex items-center gap-1.5 border border-transparent"
        >
          <span class="active-dot hidden w-1.5 h-1.5 rounded-full bg-indigo-600 dark:bg-[#8083ff] animate-pulse"></span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Social, Theme Toggle & Contact Actions -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Theme Toggle Button -->
      <button
        id="themeToggleBtn"
        type="button"
        aria-label="Toggle Color Theme"
        title="Switch Theme"
        class="p-2 text-slate-600 dark:text-[#908fa0] hover:text-indigo-600 dark:hover:text-[#c0c1ff] rounded-lg border border-slate-200 dark:border-[#1F2937] bg-slate-100 dark:bg-[#1c1f29] hover:bg-slate-200 dark:hover:bg-[#353943] transition-all flex items-center justify-center shrink-0"
      >
        <span class="material-symbols-outlined text-[18px] sm:text-[19px]" id="themeToggleIcon">
          light_mode
        </span>
      </button>

      <!-- GitHub Link (hidden on small mobile, visible on sm+) -->
      <a
        href={resumeData.personal.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex p-2 text-slate-600 dark:text-[#908fa0] hover:text-slate-900 dark:hover:text-[#dfe2ef] hover:bg-slate-100 dark:hover:bg-[#1c1f29] rounded-lg border border-transparent hover:border-slate-200 dark:hover:border-[#1F2937] transition-all"
        title="GitHub Profile"
        aria-label="GitHub Profile"
      >
        <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- LinkedIn Link (hidden on small mobile, visible on sm+) -->
      <a
        href={resumeData.personal.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex p-2 text-slate-600 dark:text-[#908fa0] hover:text-slate-900 dark:hover:text-[#dfe2ef] hover:bg-slate-100 dark:hover:bg-[#1c1f29] rounded-lg border border-transparent hover:border-slate-200 dark:hover:border-[#1F2937] transition-all"
        title="LinkedIn Profile"
        aria-label="LinkedIn Profile"
      >
        <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
        </svg>
      </a>

      <!-- Desktop Contact Button (hidden on mobile, visible on sm+) -->
      <a
        href={resumeData.personal.email.href}
        class="hidden sm:inline-flex ml-1 items-center justify-center font-mono text-[13px] px-3.5 py-1.5 rounded-lg bg-indigo-600 dark:bg-[#8083ff] text-white dark:text-[#0d0096] font-semibold hover:bg-indigo-700 dark:hover:bg-[#c0c1ff] transition-colors shadow-sm whitespace-nowrap"
      >
        Contact
      </a>

      <!-- Mobile Menu Button (visible on mobile only, hidden on md+) -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="md:hidden p-2 text-slate-600 dark:text-[#908fa0] hover:text-slate-900 dark:hover:text-[#dfe2ef] hover:bg-slate-100 dark:hover:bg-[#1c1f29] rounded-lg transition-colors focus:outline-none"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div
    id="mobile-nav-menu"
    class="hidden md:hidden border-t border-slate-200 dark:border-[#1F2937] bg-white/95 dark:bg-[#0f131c]/95 backdrop-blur-lg px-4 py-4 flex flex-col gap-1 shadow-lg"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        data-mobile-nav-section={item.href.replace('#', '')}
        class="mobile-nav-link text-slate-700 dark:text-[#dfe2ef] font-mono text-sm py-2.5 px-3 rounded-lg border border-transparent hover:bg-slate-100 dark:hover:bg-[#181b25] transition-all flex items-center justify-between"
      >
        <div class="flex items-center gap-2">
          <span class="mobile-active-dot hidden w-2 h-2 rounded-full bg-indigo-600 dark:bg-[#8083ff] animate-pulse"></span>
          <span>{item.label}</span>
        </div>
        <span class="material-symbols-outlined text-[16px] text-slate-400">arrow_forward_ios</span>
      </a>
    ))}

    <!-- Mobile Menu Extra Actions -->
    <div class="pt-3 mt-2 border-t border-slate-200 dark:border-[#1F2937] flex flex-col gap-2">
      <a
        href={resumeData.personal.email.href}
        class="w-full py-2.5 rounded-lg bg-indigo-600 dark:bg-[#8083ff] text-white dark:text-[#0d0096] font-mono text-sm font-semibold flex items-center justify-center gap-2 shadow-sm"
      >
        <span class="material-symbols-outlined text-[18px]">mail</span>
        <span>Contact Bhupesh</span>
      </a>

      <div class="grid grid-cols-2 gap-2 pt-1">
        <a
          href={resumeData.personal.github}
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 px-3 rounded-lg border border-slate-200 dark:border-[#1F2937] text-slate-700 dark:text-[#dfe2ef] font-mono text-xs flex items-center justify-center gap-1.5 hover:bg-slate-100 dark:hover:bg-[#181b25]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href={resumeData.personal.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="py-2 px-3 rounded-lg border border-slate-200 dark:border-[#1F2937] text-slate-700 dark:text-[#dfe2ef] font-mono text-xs flex items-center justify-center gap-1.5 hover:bg-slate-100 dark:hover:bg-[#181b25]"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Fixed Header Height Spacer to guarantee zero layout shift -->
<div class="h-14 w-full shrink-0" aria-hidden="true"></div>

<script>
  function setupThemeToggle() {
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeToggleIcon');
    const root = document.documentElement;

    function updateThemeUI(isDark: boolean) {
      if (themeIcon) {
        themeIcon.textContent = isDark ? 'light_mode' : 'dark_mode';
      }
      if (themeBtn) {
        themeBtn.setAttribute('title', isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode');
      }
    }

    const isInitialDark = root.classList.contains('dark');
    updateThemeUI(isInitialDark);

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const isDark = root.classList.contains('dark');
        if (isDark) {
          root.classList.remove('dark');
          localStorage.setItem('theme', 'light');
          updateThemeUI(false);
        } else {
          root.classList.add('dark');
          localStorage.setItem('theme', 'dark');
          updateThemeUI(true);
        }
      });
    }

    // Mobile nav toggle
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const navMenu = document.getElementById('mobile-nav-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (toggleBtn && navMenu) {
      toggleBtn.addEventListener('click', () => {
        const isOpen = !navMenu.classList.contains('hidden');
        if (isOpen) {
          navMenu.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        } else {
          navMenu.classList.remove('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        }
      });

      // Close mobile menu on any link click
      navMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          navMenu.classList.add('hidden');
          toggleBtn.setAttribute('aria-expanded', 'false');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        });
      });
    }
  }

  function setupScrollSpy() {
    const sections = ['experience', 'projects', 'research', 'skills', 'education'];
    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-section]');

    function setActive(sectionId: string | null) {
      desktopLinks.forEach((link) => {
        const targetId = link.getAttribute('data-nav-section');
        const dot = link.querySelector('.active-dot');
        if (sectionId && targetId === sectionId) {
          link.classList.add(
            'text-indigo-600',
            'dark:text-[#c0c1ff]',
            'font-semibold',
            'bg-indigo-50/90',
            'dark:bg-[#8083ff]/15',
            'border-indigo-200/90',
            'dark:border-[#8083ff]/30',
            'shadow-xs'
          );
          link.classList.remove('text-slate-600', 'dark:text-[#908fa0]', 'border-transparent');
          dot?.classList.remove('hidden');
        } else {
          link.classList.remove(
            'text-indigo-600',
            'dark:text-[#c0c1ff]',
            'font-semibold',
            'bg-indigo-50/90',
            'dark:bg-[#8083ff]/15',
            'border-indigo-200/90',
            'dark:border-[#8083ff]/30',
            'shadow-xs'
          );
          link.classList.add('text-slate-600', 'dark:text-[#908fa0]', 'border-transparent');
          dot?.classList.add('hidden');
        }
      });

      mobileLinks.forEach((link) => {
        const targetId = link.getAttribute('data-mobile-nav-section');
        const dot = link.querySelector('.mobile-active-dot');
        if (sectionId && targetId === sectionId) {
          link.classList.add(
            'text-indigo-600',
            'dark:text-[#c0c1ff]',
            'font-semibold',
            'bg-indigo-50/90',
            'dark:bg-[#8083ff]/15',
            'border-indigo-200/80',
            'dark:border-[#8083ff]/30'
          );
          link.classList.remove('text-slate-700', 'dark:text-[#dfe2ef]', 'border-transparent');
          dot?.classList.remove('hidden');
        } else {
          link.classList.remove(
            'text-indigo-600',
            'dark:text-[#c0c1ff]',
            'font-semibold',
            'bg-indigo-50/90',
            'dark:bg-[#8083ff]/15',
            'border-indigo-200/80',
            'dark:border-[#8083ff]/30'
          );
          link.classList.add('text-slate-700', 'dark:text-[#dfe2ef]', 'border-transparent');
          dot?.classList.add('hidden');
        }
      });
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;

          // If near top of page (hero section), no section is highlighted
          if (scrollY < 180) {
            setActive(null);
            ticking = false;
            return;
          }

          // If scrolled to bottom of the page, activate the last section ('education')
          if (window.innerHeight + scrollY >= document.documentElement.scrollHeight - 70) {
            setActive('education');
            ticking = false;
            return;
          }

          // Check current section
          const scrollPos = scrollY + 120; // 56px navbar + offset
          let current: string | null = null;
          for (const id of sections) {
            const el = document.getElementById(id);
            if (el) {
              const top = el.offsetTop;
              const height = el.offsetHeight;
              if (scrollPos >= top && scrollPos < top + height) {
                current = id;
                break;
              }
            }
          }

          setActive(current);
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  function init() {
    setupThemeToggle();
    setupScrollSpy();
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
