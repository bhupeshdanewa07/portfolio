---
import { resumeData } from '../data/resume';
---

<section class="flex flex-col gap-6 scroll-mt-20" id="education">
  <!-- Section Header -->
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-[#1F2937]/80 pb-3 transition-colors">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-indigo-600 dark:text-[#c0c1ff] text-[20px] sm:text-[22px]">badge</span>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-900 dark:text-[#dfe2ef] tracking-tight">
        Education & Certifications
      </h2>
    </div>
    <span class="font-mono text-xs sm:text-[13px] text-slate-500 dark:text-[#908fa0]">accreditation</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- Column 1: Education -->
    <div class="relative overflow-hidden bg-white/90 dark:bg-[#181b25]/90 border border-slate-200 dark:border-[#1F2937] rounded-xl p-4 sm:p-6 flex flex-col gap-4 sm:gap-5 shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_25px_-5px_rgba(128,131,255,0.2)] transition-all hover:-translate-y-1 hover:border-indigo-400 dark:hover:border-[#8083ff] duration-300 group backdrop-blur-sm">
      <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-indigo-500 dark:via-[#8083ff] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      <div class="flex items-center gap-2 border-b border-slate-200 dark:border-[#1F2937]/60 pb-2">
        <span class="material-symbols-outlined text-indigo-600 dark:text-[#c0c1ff] text-[18px] sm:text-[20px]">school</span>
        <h3 class="text-base sm:text-[18px] text-slate-900 dark:text-[#dfe2ef] font-semibold">
          Formal Education
        </h3>
      </div>
      <div class="flex flex-col gap-4 sm:gap-5">
        {resumeData.education.map((edu, idx) => {
          const isPostgrad = idx === 0;
          return (
            <div
              class={`flex flex-col gap-1 border-l-2 pl-3 sm:pl-3.5 ${
                isPostgrad ? "border-indigo-600 dark:border-[#8083ff]" : "border-slate-300 dark:border-[#1F2937]"
              }`}
            >
              <span
                class={`font-mono text-[10px] sm:text-[11px] uppercase tracking-wider font-semibold ${
                  isPostgrad ? "text-indigo-600 dark:text-[#c0c1ff]" : "text-slate-500 dark:text-[#908fa0]"
                }`}
              >
                {edu.levelTag}
              </span>
              <h4 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-[#dfe2ef]">
                {edu.degree}
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-[#c7c4d7]">
                {edu.institution}, {edu.location}
              </p>
              <span class="font-mono text-xs sm:text-[13px] text-slate-500 dark:text-[#908fa0]">
                {edu.dates}
              </span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Column 2: Certifications -->
    <div class="relative overflow-hidden bg-white/90 dark:bg-[#181b25]/90 border border-slate-200 dark:border-[#1F2937] rounded-xl p-4 sm:p-6 flex flex-col gap-4 sm:gap-5 shadow-sm hover:shadow-xl hover:shadow-emerald-500/10 dark:hover:shadow-[0_0_25px_-5px_rgba(78,222,163,0.2)] transition-all hover:-translate-y-1 hover:border-emerald-400 dark:hover:border-[#4edea3] duration-300 group backdrop-blur-sm">
      <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-emerald-500 dark:via-[#4edea3] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
      <div class="flex items-center gap-2 border-b border-slate-200 dark:border-[#1F2937]/60 pb-2">
        <span class="material-symbols-outlined text-emerald-600 dark:text-[#4edea3] text-[18px] sm:text-[20px]">workspace_premium</span>
        <h3 class="text-base sm:text-[18px] text-slate-900 dark:text-[#dfe2ef] font-semibold">
          Verified Credentials
        </h3>
      </div>
      <div class="flex flex-col gap-3 sm:gap-4">
        {resumeData.certifications.map((cert) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3 sm:p-3.5 bg-slate-50 dark:bg-[#1c1f29] rounded-lg border border-slate-200 dark:border-[#1F2937] hover:border-emerald-400/50 dark:hover:border-[#4edea3]/40 transition-colors">
            <div class="flex flex-col">
              <span class="font-mono text-[10px] sm:text-[11px] font-semibold text-emerald-600 dark:text-[#4edea3] uppercase">
                {cert.tag}
              </span>
              <h4 class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-[#dfe2ef] mt-0.5">
                {cert.name}
              </h4>
            </div>
            <a
              href={cert.linkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-3 py-1.5 rounded bg-white dark:bg-[#181b25] border border-slate-200 dark:border-[#1F2937] text-indigo-600 dark:text-[#c0c1ff] hover:border-indigo-500 dark:hover:border-[#8083ff] font-mono text-xs sm:text-[13px] shrink-0 flex items-center justify-center gap-1 transition-colors shadow-sm text-center"
            >
              <span>{cert.linkLabel}</span>
              <span class="material-symbols-outlined text-[14px]">verified</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
