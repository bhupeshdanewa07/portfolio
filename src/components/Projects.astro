---
import { resumeData } from '../data/resume';
---

<section class="flex flex-col gap-6 scroll-mt-20" id="projects">
  <!-- Section Title -->
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-[#1F2937]/80 pb-3 transition-colors">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-indigo-600 dark:text-[#c0c1ff] text-[20px] sm:text-[22px]">developer_board</span>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-slate-900 dark:text-[#dfe2ef] tracking-tight">
        Featured Projects
      </h2>
    </div>
    <span class="font-mono text-xs sm:text-[13px] text-slate-500 dark:text-[#908fa0]">verified_artifacts</span>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
    {resumeData.projects.map((project) => (
      <article class="relative overflow-hidden bg-white/90 dark:bg-[#181b25]/90 border border-slate-200 dark:border-[#1F2937] rounded-xl p-4 sm:p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:border-indigo-400 dark:hover:border-[#8083ff] shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_30px_-5px_rgba(128,131,255,0.25)] group backdrop-blur-sm">
        <!-- Top Border Illuminating Glow Accent -->
        <div class="absolute inset-x-0 -top-px h-[2px] bg-gradient-to-r from-transparent via-indigo-500 dark:via-[#8083ff] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

        <div class="flex flex-col gap-3">
          <!-- Card Header: Tag & Link -->
          <div class="flex items-start justify-between">
            <span class="px-2 py-0.5 bg-slate-100 dark:bg-[#1c1f29] border border-slate-200 dark:border-[#1F2937] rounded font-mono text-[10px] sm:text-[11px] font-semibold text-emerald-600 dark:text-[#4edea3] uppercase">
              {project.categoryTag}
            </span>
            <a
              href={project.linkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 dark:text-[#908fa0] group-hover:text-indigo-600 dark:group-hover:text-[#c0c1ff] transition-colors flex items-center gap-1 font-mono text-xs sm:text-[13px]"
              title={`View ${project.title} on ${project.linkLabel}`}
            >
              <span>{project.linkLabel}</span>
              <span class="material-symbols-outlined text-[15px] sm:text-[16px] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">open_in_new</span>
            </a>
          </div>

          <!-- Project Title -->
          <h3 class="text-base sm:text-lg md:text-xl text-slate-900 dark:text-[#dfe2ef] group-hover:text-indigo-950 dark:group-hover:text-white font-semibold leading-snug transition-colors">
            {project.title}
          </h3>

          <!-- Metric Badges -->
          <div class="flex flex-wrap gap-1.5 sm:gap-2 my-1">
            {project.metricBadges.map((badge) => (
              <span class="px-2 py-0.5 sm:py-1 bg-emerald-50/80 dark:bg-[#0a0e17] border border-emerald-300 dark:border-[#00a572]/40 text-emerald-700 dark:text-[#4edea3] rounded font-mono text-[11px] sm:text-[12px] font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined text-[13px] sm:text-[14px]">bolt</span>
                {badge}
              </span>
            ))}
          </div>

          <!-- Bullet Points -->
          <ul class="flex flex-col gap-2 text-slate-600 dark:text-[#c7c4d7] text-xs sm:text-sm leading-relaxed list-disc list-outside pl-4">
            {project.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>

        <!-- Tech Stack Tags -->
        <div class="mt-5 pt-3 border-t border-slate-100 dark:border-[#1F2937]/80 flex flex-wrap gap-1 sm:gap-1.5">
          {project.techTags.map((tech) => (
            <span class="font-mono text-[9px] sm:text-[10px] font-medium uppercase px-2 py-0.5 rounded bg-slate-100 dark:bg-[#1c1f29] text-slate-700 dark:text-[#c7c4d7] border border-slate-200/60 dark:border-[#1F2937]/50">
              {tech}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>

  <!-- View More Projects on GitHub Callout -->
  <div class="flex justify-center pt-2">
    <a
      href={resumeData.personal.github}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-slate-200 dark:border-[#1F2937] bg-white/90 dark:bg-[#181b25]/90 text-slate-800 dark:text-[#dfe2ef] hover:text-indigo-600 dark:hover:text-[#c0c1ff] hover:border-indigo-400 dark:hover:border-[#8083ff] font-mono text-xs sm:text-[13px] font-semibold transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-indigo-500/10 dark:hover:shadow-[0_0_25px_-5px_rgba(128,131,255,0.2)] hover:-translate-y-1 group text-center"
    >
      <svg class="w-4 h-4 text-slate-600 dark:text-[#908fa0] group-hover:text-indigo-600 dark:group-hover:text-[#c0c1ff] transition-colors shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
      <span>Go to GitHub to see more projects</span>
      <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform shrink-0">open_in_new</span>
    </a>
  </div>
</section>
