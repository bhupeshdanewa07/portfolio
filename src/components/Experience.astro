---
import { resumeData } from '../data/resume';
---

<section class="flex flex-col gap-6" id="experience">
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-[#1F2937]/80 pb-3 transition-colors">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-indigo-600 dark:text-[#c0c1ff] text-[22px]">history_edu</span>
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-[#dfe2ef] tracking-tight">
        Work Experience
      </h2>
    </div>
    <span class="font-mono text-[13px] text-slate-500 dark:text-[#908fa0]">timeline:prod</span>
  </div>

  <div class="relative border-l border-slate-200 dark:border-[#1F2937] ml-3 md:ml-4 pl-6 md:pl-8 flex flex-col gap-6">
    {resumeData.experience.map((exp) => {
      const isCurrent = exp.dates.includes("Present");
      return (
        <div class="relative flex flex-col gap-2 bg-white dark:bg-[#181b25] border border-slate-200 dark:border-[#1F2937] rounded-xl p-5 md:p-6 transition-all hover:-translate-y-0.5 hover:border-slate-300 dark:hover:border-[#464554] duration-150 shadow-sm group">
          <!-- Timeline Indicator Dot -->
          <div
            class={`absolute -left-[31px] md:-left-[39px] top-6 w-3.5 h-3.5 rounded-full border-2 border-slate-50 dark:border-[#0a0e17] ${
              isCurrent ? "bg-emerald-500 dark:bg-[#4edea3]" : "bg-slate-400 dark:bg-[#908fa0]"
            }`}
          ></div>

          <!-- Header & Meta -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-1">
            <div>
              <span
                class={`font-mono text-[11px] uppercase tracking-wider font-semibold ${
                  isCurrent ? "text-emerald-600 dark:text-[#4edea3]" : "text-sky-600 dark:text-[#7bd0ff]"
                }`}
              >
                {exp.tag}
              </span>
              <h3 class="text-xl text-slate-900 dark:text-[#dfe2ef] font-semibold mt-0.5">
                {exp.role}
              </h3>
              <p class="text-indigo-600 dark:text-[#c0c1ff] font-mono text-[13px] font-medium">
                {exp.organization}
              </p>
            </div>
            <div class="font-mono text-[13px] text-slate-500 dark:text-[#908fa0] flex items-center gap-1.5 self-start md:self-auto">
              <span class="material-symbols-outlined text-[15px]">event</span>
              {exp.location} | {exp.dates}
            </div>
          </div>

          <!-- Bullet Points -->
          <ul class="mt-2 flex flex-col gap-2 text-slate-600 dark:text-[#c7c4d7] text-sm leading-relaxed list-disc list-outside pl-4">
            {exp.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>
